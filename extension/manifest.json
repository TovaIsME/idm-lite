{
  "manifest_version": 3,
  "name": "IDM-lite Integration",
  "version": "1.0.3",
  "description": "Hands browser downloads to the IDM-lite download manager.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM-lite",
    "default_icon": { "16": "icon16.png", "48": "icon48.png" }
  }
}
